; Engine configuration file.
; Godot 에디터의 Project Settings에서 바꾸는 값이 여기에 저장된다.

config_version=5

[application]

config/name="Before Sundown"
config/name_localized={
"ko": "해 지기 전에"
}
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://scripts/autoload/settings.gd"
GameState="*res://scripts/autoload/game_state.gd"
NoiseBus="*res://scripts/autoload/noise_bus.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

